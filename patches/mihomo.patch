+func TestPhysicalSnapshotExcludesTunAndUnsafeAddresses(t *testing.T){
+ s:=PhysicalSnapshot([]string{"192.0.2.111","192.0.2.111","10.144.77.2","172.19.0.1","127.0.0.1","0.0.0.0","ff02::1","fe80::1","bad","2409:1234::1"})
