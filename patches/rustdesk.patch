@@ -0,0 +1,79 @@
+import 'dart:async';
+import 'package:flutter/services.dart';
+
+// Only a remote page with authenticated peer information can authorize the
+// native development bridge. Opening the RustDesk home page grants nothing.
+class WangChuanDevelopment {
+  static const _channel = MethodChannel('wangchuan/development');
+  static String? _peer;
+  static bool _authenticated = false;
+  static Timer? _heartbeat;
+  static int _mouseAttempts = 0;
+  static int _keyAttempts = 0;
+  static Map<String, Object> _inputState = {};
+  static Map<String, Object> _gestureState = {};
+
+  static void gesture(String stage, {bool? value}) {
+    if (_peer == null) return;
+    _gestureState[stage] = (_gestureState[stage] as int? ?? 0) + 1;
+    if (value != null) _gestureState['${stage}Result'] = value;
+  }
+
+  // Counts and permission flags only: never key names, text or coordinates.
+  static void inputAttempt(String kind, bool permitted, bool camera, bool sessionMatches) {
+    if (_peer == null) return;
+    if (kind == 'mouse') _mouseAttempts++; else _keyAttempts++;
+    _inputState = {'mouseAttempts': _mouseAttempts, 'keyAttempts': _keyAttempts,
+      'permitted': permitted, 'camera': camera, 'sessionMatches': sessionMatches};
+  }
+
+  static Future<String?> pairedPassword(String peer) async {
+    try {
+      return await _channel.invokeMethod<String>('pairedRemotePassword', {'peer': peer});
+    } on MissingPluginException {
+      return null;
+    } on PlatformException {
+      return null;
+    }
+  }
+
+  static void open(String peer) {
+    close();
+    _mouseAttempts = 0; _keyAttempts = 0; _inputState = {}; _gestureState = {};
+    _peer = peer;
+  }
+
+  static void authenticated(String peer) {
+    if (_peer != peer) return;
+    _authenticated = true;
+    _send();
+    _heartbeat ??= Timer.periodic(const Duration(seconds: 4), (_) => _send());
+  }
+
+  static void disconnected(String peer) {
+    if (_peer != peer) return;
+    _authenticated = false;
+    _heartbeat?.cancel();
+    _heartbeat = null;
+    _send();
+  }
+
+  static void close() {
+    if (_peer != null) disconnected(_peer!);
+    _peer = null;
+  }
+
+  static Future<void> _send() async {
+    try {
+      await _channel.invokeMethod('remoteState', {
+        'peer': _peer ?? '', 'ready': _authenticated,
+        if (_inputState.isNotEmpty) 'inputState': _inputState,
+        if (_gestureState.isNotEmpty) 'gestureState': _gestureState,
+      });
+    } on MissingPluginException {
+      // The upstream desktop builds do not contain our Android host.
+    } on PlatformException {
+      // Missing heartbeats make the native bridge revoke its lease.
+    }
+  }
+}
